# Port the API listens on
PORT=4000

# development | production | test (unset or empty = production)
# Only "development" enables pretty logs and detailed error messages.
# `pnpm dev` already sets it to development.
NODE_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace | silent
# Defaults to "debug" in development and "info" otherwise
LOG_LEVEL=debug

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://flock_admin:flock_dev@localhost:5432/flock?schema=public

# Redis connection (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
