# Port the API listens on
PORT=4000

# development | production
# Only "development" enables pretty logs and detailed error messages; anything else
# (including unset) behaves as production. `pnpm dev` already sets it to development.
NODE_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace | silent
# Defaults to "debug" in development and "info" otherwise
LOG_LEVEL=debug
