generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// CHECK constraints: see migration init
model Company {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String   @db.VarChar(100)
  timezone           String   @default("Europe/Kyiv") @db.VarChar(64)
  shiftLengthMin     Int      @default(480) @map("shift_length_min")
  pickupHandlingMin  Int      @default(5) @map("pickup_handling_min")
  dropoffHandlingMin Int      @default(10) @map("dropoff_handling_min")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicles Vehicle[]
  users    User[]
  orders   Order[]
  routes   Route[]
  stops    Stop[]

  @@map("companies")
}

// CHECK constraints: see migration init
/// Soft-deleted via deletedAt, never hard-deleted
model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  name          String         @db.VarChar(100)
  role          UserRole
  email         String         @unique @db.VarChar(254) // in future can be @@unique([companyId, email]) + tenant selection
  passwordHash  String?        @map("password_hash")
  dispatcherId  String?        @map("dispatcher_id") @db.Uuid
  courierStatus CourierStatus? @map("courier_status")
  isSample      Boolean        @default(false) @map("is_sample")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispatcher User?   @relation("DispatcherCouriers", fields: [dispatcherId], references: [id], onDelete: SetNull)
  couriers   User[]  @relation("DispatcherCouriers")
  routes     Route[]

  @@index([companyId, role])
  @@index([dispatcherId])
  @@map("users")
}

// CHECK constraints: see migration init
/// Soft-deleted via deletedAt, never hard-deleted
model Vehicle {
  id          String      @id @default(uuid(7)) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  type        VehicleType
  vin         String?     @db.VarChar(17)
  legalNumber String?     @map("legal_number") @db.VarChar(10)
  color       String      @db.VarChar(30)
  isSample    Boolean     @default(false) @map("is_sample")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  routes Route[]

  @@unique([companyId, vin])
  @@unique([companyId, legalNumber])
  @@index([companyId, type])
  @@map("vehicles")
}

// CHECK constraints: see migration init
model Order {
  id                 String      @id @default(uuid(7)) @db.Uuid
  companyId          String      @map("company_id") @db.Uuid
  /// Package weight in grams
  weight             Int
  /// Package size in cm
  length             Int
  /// Package size in cm
  width              Int
  /// Package size in cm
  height             Int
  // pickup info
  /// Contact person at pickup
  pickupName         String      @map("pickup_name") @db.VarChar(100)
  pickupPhone        String      @map("pickup_phone") @db.VarChar(20)
  pickupWindowStart  DateTime?   @map("pickup_window_start") @db.Timestamptz
  pickupWindowEnd    DateTime?   @map("pickup_window_end") @db.Timestamptz
  pickupAddress      String      @map("pickup_address") @db.VarChar(500)
  pickupComment      String?     @map("pickup_comment") @db.VarChar(500)
  pickupLat          Float       @map("pickup_lat")
  pickupLng          Float       @map("pickup_lng")
  // dropoff info
  /// Contact person at dropoff
  dropoffName        String      @map("dropoff_name") @db.VarChar(100)
  dropoffPhone       String      @map("dropoff_phone") @db.VarChar(20)
  dropoffWindowStart DateTime?   @map("dropoff_window_start") @db.Timestamptz
  dropoffWindowEnd   DateTime?   @map("dropoff_window_end") @db.Timestamptz
  dropoffAddress     String      @map("dropoff_address") @db.VarChar(500)
  dropoffComment     String?     @map("dropoff_comment") @db.VarChar(500)
  dropoffLat         Float       @map("dropoff_lat")
  dropoffLng         Float       @map("dropoff_lng")
  trackingToken      String      @unique @map("tracking_token")
  type               OrderType   @default(ASAP)
  status             OrderStatus @default(NEW)
  isSample           Boolean     @default(false) @map("is_sample")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stops Stop[]

  @@index([companyId, status])
  @@map("orders")
}

// CHECK constraints: see migration init
model Route {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  courierId String      @map("courier_id") @db.Uuid
  vehicleId String      @map("vehicle_id") @db.Uuid
  shiftDate DateTime    @map("shift_date") @db.Date
  status    RouteStatus @default(PLANNED)
  /// Distance in m
  distance  Int?
  /// Duration in min
  duration  Int?
  isSample  Boolean     @default(false) @map("is_sample")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  courier User    @relation(fields: [courierId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  stops Stop[]

  @@index([companyId, shiftDate])
  @@index([courierId, shiftDate])
  @@index([vehicleId])
  @@map("routes")
}

// CHECK constraints: see migration init
model Stop {
  id          String     @id @default(uuid(7)) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  routeId     String     @map("route_id") @db.Uuid
  orderId     String     @map("order_id") @db.Uuid
  type        StopType
  lat         Float
  lng         Float
  sequence    Int
  status      StopStatus @default(PENDING)
  arrivedAt   DateTime?  @map("arrived_at") @db.Timestamptz
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  failReason  String?    @map("fail_reason") @db.VarChar(500)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([routeId, orderId, type])
  @@unique([routeId, sequence])
  @@index([orderId])
  @@map("stops")
}

